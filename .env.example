# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=ton_token_ici
# Optionnel : ID de ton serveur => les commandes apparaissent instantanément.
# Laisse vide pour des commandes globales (jusqu'à 1h de délai la 1ère fois).
GUILD_ID=
# Heures minimum entre 2 vouchs du même membre vers la même personne
VOUCH_COOLDOWN_HOURS=24

# Clé API OpenAI (pas encore utilisée par le bot)
OPENAI_API_KEY=
